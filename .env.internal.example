# Internal pilot (≤5 users) — copy to apps/web/.env.production.local (gitignored)
# API secrets live on the server only; see deploy/internal/api.env.example

VITE_API_BASE_URL=https://mbox-api.corp.example.com
VITE_API_KEY=replace-with-team-shared-secret-from-password-manager
VITE_WORKSPACE_ID=company-pilot
VITE_USE_SERVER_VAULT=true
VITE_LOCALHOST_DEMO=false
VITE_ENABLE_DEV_ASSET_BATCH=false
