# Local Vite dev — IndexedDB vault, local API (overrides production bake if any).
MBOX_WEB_DEV_PORT=5173
MBOX_WEB_PREVIEW_PORT=4173
VITE_API_BASE_URL=http://localhost:8787
VITE_USE_SERVER_VAULT=false
VITE_RENDER_BACKEND=local
VITE_SHOWCASE_LOCAL_ONLY=true
VITE_LOCALHOST_DEMO=true
# Cloud API key (optional): apps/web/.env.local — required only when VITE_API_BASE_URL points at Cloud Run.
# Machine-specific: set MBOX_LUXURY_SOURCE in apps/web/.env.local (not committed).
