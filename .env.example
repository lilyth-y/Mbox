# apps/api
GOOGLE_CLOUD_PROJECT=ai-toolbox-production
GOOGLE_CLOUD_LOCATION=asia-northeast3
# Background removal: matte (default, Seoul-safe) | vertex (needs image-model region)
# BACKGROUND_REMOVAL_PROVIDER=matte
API_PORT=8787
CORS_ORIGIN=http://localhost:5173
# API_KEY=
# RATE_LIMIT_PER_MINUTE=120
# WORKSPACE_DATA_DIR=./data/workspaces

# apps/web — 누끼: @imgly/background-removal 버전은 packages/shared/src/background-removal.ts 와 apps/web/package.json 을 함께 올릴 것
# apps/web
VITE_API_BASE_URL=http://localhost:8787
VITE_LOCALHOST_DEMO=true
# VITE_USE_SERVER_VAULT=false
# VITE_API_KEY=
# VITE_WORKSPACE_ID=default
# VITE_ENABLE_DEV_ASSET_BATCH=true
