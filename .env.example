# apps/api
GOOGLE_CLOUD_PROJECT=ai-toolbox-production
GOOGLE_CLOUD_LOCATION=asia-northeast3
# Background removal: matte (default, Seoul-safe) | vertex (needs image-model region)
# BACKGROUND_REMOVAL_PROVIDER=vertex
# --- Local ports (see docs/ports.md) ---
MBOX_WEB_DEV_PORT=5173
MBOX_WEB_PREVIEW_PORT=4173
API_PORT=8787
CORS_ORIGIN=http://localhost:5173
# Dev only: allow Origin "null" (file:// wedding-simple). Production uses NODE_ENV=production.
# CORS_ALLOW_NULL_ORIGIN=true
# API_KEY=
# Hosted verify / e2e scripts: copy Secret Manager `mbox-api-key` to repo-root `.env.local` as MBOX_API_KEY=
# RATE_LIMIT_PER_MINUTE=120
# WORKSPACE_DATA_DIR=./data/workspaces

# apps/web — 누끼: @imgly/background-removal 버전은 packages/shared/src/background-removal.ts 와 apps/web/package.json 을 함께 올릴 것
# apps/web
VITE_API_BASE_URL=http://localhost:8787
VITE_LOCALHOST_DEMO=false
# Offline showcase upload only (no Cloud Run /analyze)
# VITE_SHOWCASE_LOCAL_ONLY=true
# VITE_USE_SERVER_VAULT=false
# VITE_API_KEY=
# VITE_WORKSPACE_ID=default
# VITE_ENABLE_DEV_ASSET_BATCH=true
# MP4 export: local (browser) or cloud (render worker). Default: local
# VITE_RENDER_BACKEND=local
# API: spawn inline render worker on job create (dev default when NODE_ENV != production)
# RENDER_WORKER_ENABLED=true
# Optional: Exa deep search for presentation quality research (scripts/research/exa-presentation-quality.mjs)
# EXA_API_KEY=
