# Upload only what Docker / npm need (speeds `gcloud builds submit`).
.git
.gitignore
.cursor
.vscode
**/.DS_Store
Thumbs.db
*.log

node_modules
**/node_modules
.cache
**/.cache

# Incremental TS info must not ship without dist/ (tsc would skip emit and break @mbox/api build)
**/*.tsbuildinfo

# Rebuilt in Cloud Build
apps/web/dist
apps/api/dist
packages/shared/dist

experiments/outputs
/experiments/
/data/
!data/background/
!data/background/**
/research/
/scratch/
/scratchpad*
/wedding-simple/
/cs5/
screenshots/
PR_deck/
*.pdf
data/workspaces

# Large media not needed for npm build (allow showcase backgrounds)
**/*.mp4
**/*.mov
!data/background/**
!data/background/**/*.mp4
!data/background/**/*.mov
**/*.pptx
**/*.wasm
!apps/web/public/havok/HavokPhysics.wasm

.playwright-mcp
.snapshots
