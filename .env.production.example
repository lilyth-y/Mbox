# --- API (Cloud Run / VM) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=asia-northeast3
API_PORT=8080
API_HOST=0.0.0.0
# Comma-separated web origins
CORS_ORIGIN=https://app.example.com
# Required for staging/production (same value as VITE_API_KEY on web build)
API_KEY=replace-with-long-random-secret
RATE_LIMIT_PER_MINUTE=120
WORKSPACE_DATA_DIR=/var/lib/mbox/workspaces

# --- Web (build-time Vite env) ---
VITE_API_BASE_URL=https://api.example.com
VITE_API_KEY=replace-with-long-random-secret
VITE_WORKSPACE_ID=default
VITE_USE_SERVER_VAULT=true
VITE_LOCALHOST_DEMO=false
VITE_ENABLE_DEV_ASSET_BATCH=false
