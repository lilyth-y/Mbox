# Cloud Run runtime — measured from cloudbuild.yaml (project newmedia-496107)
# Store live secrets in Secret Manager; inject via --set-secrets=API_KEY=mbox-api-key:latest

GOOGLE_CLOUD_PROJECT=newmedia-496107
GOOGLE_CLOUD_LOCATION=asia-northeast3
BACKGROUND_REMOVAL_PROVIDER=matte

# Cloud Run container listen port (not local dev 8787)
API_PORT=8080
API_HOST=0.0.0.0

# Must match browser Origin when calling API from GCS-hosted web
CORS_ORIGIN=https://storage.googleapis.com,https://mbox-web-newmedia-496107.storage.googleapis.com

# Same secret as VITE_API_KEY in apps/web/.env.production.local
API_KEY=mbox-prod-j5WzZTkM3KLekOEkox7rmKamTqUf9gky

RATE_LIMIT_PER_MINUTE=180
WORKSPACE_DATA_DIR=/var/lib/mbox/workspaces
GCS_VAULT_BUCKET=mbox-vault-newmedia-496107

# Cloud Run service (cloudbuild _CLOUD_RUN_SERVICE)
# CLOUD_RUN_SERVICE=mbox-api
# WEB_BUCKET=mbox-web-newmedia-496107
# _RUN_ALLOW_UNAUTHENTICATED=true   # set false + IAP for corp-only lockdown
