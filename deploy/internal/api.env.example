# Cloud Run / VM runtime — store real values in Secret Manager, not git
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=asia-northeast3
# remove_background: matte (Seoul-safe) | vertex (image model region required)
BACKGROUND_REMOVAL_PROVIDER=matte
API_PORT=8080
API_HOST=0.0.0.0
CORS_ORIGIN=https://mbox.corp.example.com
API_KEY=replace-with-team-shared-secret
RATE_LIMIT_PER_MINUTE=180
WORKSPACE_DATA_DIR=/var/lib/mbox/workspaces
