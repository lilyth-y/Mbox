{
  "name": "mbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mbox/shared && npm run build --workspace @mbox/api && npm run build --workspace @mbox/web",
    "check:cloudbuild": "python scripts/check_cloudbuild_consistency.py",
    "check:imgly-pin": "node scripts/check-imgly-pin.mjs",
    "check:mp4-structure": "node scripts/inspect-mp4-structure.mjs",
    "setup:bgm": "node scripts/setup-default-bgm.mjs",
    "sync:cs5": "node scripts/sync-cs5-public.mjs",
    "verify:cube-frames": "node scripts/verify-cube-frames.mjs",
    "verify:bg-removal": "node scripts/verify-background-removal.mjs",
    "verify:wedding-simple": "node scripts/verify-wedding-simple-e2e.mjs",
    "verify:local": "tsx scripts/verify-fan-timeline.mjs && tsx scripts/verify-fan-choreography.mjs && node scripts/verify-background-removal.mjs && node scripts/verify-cube-frames.mjs",
    "test:api-matte": "node scripts/test-api-matte.mjs",
    "verify:hosted": "node scripts/verify-hosted-deploy.mjs",
    "verify:photo-slideshow-timeline": "tsx scripts/verify-photo-slideshow-timeline.ts",
    "verify:fan-choreography": "tsx scripts/verify-fan-choreography.mjs",
    "analyze:fan-frames": "tsx scripts/analyze-fan-frames.mjs",
    "analyze:fan-rotation": "tsx scripts/analyze-fan-rotation.mjs",
    "measure:entrance-ehi": "tsx scripts/measure-entrance-ehi.mjs --all-attempts",
    "measure:entrance-ehi:gate": "tsx scripts/measure-entrance-ehi.mjs --gate",
    "ralph:entrance-hologram": "node scripts/ralph-entrance-hologram.mjs",
    "measure:rotation-rsi": "tsx scripts/measure-rotation-satisfaction.mjs --sweep",
    "measure:rotation-rsi:gate": "tsx scripts/measure-rotation-satisfaction.mjs --gate",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace @mbox/api\" \"npm run dev --workspace @mbox/web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0"
  },
  "overrides": {
    "@imgly/background-removal": {
      "onnxruntime-web": "1.21.0"
    }
  }
}
