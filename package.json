{
  "name": "mbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mbox/shared && npm run build --workspace @mbox/api && npm run build --workspace @mbox/web",
    "check:cloudbuild": "python scripts/check_cloudbuild_consistency.py",
    "check:imgly-pin": "node scripts/check-imgly-pin.mjs",
    "check:mp4-structure": "node scripts/inspect-mp4-structure.mjs",
    "setup:bgm": "node scripts/setup-default-bgm.mjs",
    "download:commercial-bgm": "node scripts/download-commercial-bgm.mjs",
    "sync:background-catalog": "node scripts/generate-background-catalog.mjs",
    "sync:backgrounds:local": "node scripts/sync-backgrounds-local.mjs --minimal",
    "sync:backgrounds:gcs": "node scripts/sync-backgrounds-to-gcs.mjs",
    "deploy:web:gcs": "node scripts/deploy-web-gcs.mjs",
    "deploy:web:gcs:full": "node scripts/deploy-web-gcs.mjs --backgrounds",
    "gcp:scale-to-zero": "node scripts/gcp-scale-to-zero.mjs",
    "sync:user-assets": "node scripts/generate-user-assets-catalog.mjs",
    "sync:havok-wasm": "node scripts/sync-havok-wasm.mjs",
    "sync:luxury": "node scripts/sync-luxury-from-mbox.mjs",
    "verify:user-assets": "node scripts/verify-user-assets-consistency.mjs",
    "verify:bg-removal": "node scripts/verify-background-removal.mjs",
    "verify:workspace": "npx tsx scripts/verify-workspace-local-keys.mjs && node scripts/verify-workspace-server-vault.mjs",
    "test:api-matte": "node scripts/test-api-matte.mjs",
    "verify:hosted": "node scripts/verify-hosted-deploy.mjs",
    "verify:showcase-manifest": "node scripts/showcase-content-manifest.mjs",
    "verify:showcase-commercial": "npm run build --workspace @mbox/shared && node scripts/showcase-commercial-goals.mjs",
    "verify:showcase-commercial:e2e": "npm run build --workspace @mbox/shared && node scripts/showcase-commercial-goals.mjs --run-e2e",
    "verify:showcase-shapes": "node scripts/verify-showcase-shapes.mjs",
    "verify:showcase-shapes:live": "node scripts/verify-showcase-shapes.mjs --live",
    "verify:showcase-photo-batch": "node scripts/verify-showcase-photo-batch.mjs",
    "human-smoke:showcase": "node scripts/human-smoke-showcase.mjs",
    "verify:gpu-worker-parity": "node scripts/verify-gpu-worker-parity.mjs",
    "verify:chrome-companion": "node scripts/verify-chrome-companion.mjs",
    "verify:single-inner-photo": "node scripts/verify-single-inner-photo.mjs",
    "verify:showcase-pipeline": "node scripts/verify-showcase-pipeline.mjs",
    "verify:showcase-pipeline:fast": "node scripts/verify-showcase-pipeline.mjs --fast",
    "verify:showcase-pipeline:e2e": "npm run verify:showcase-pipeline",
    "verify:showcase-upload-e2e": "node scripts/verify-showcase-upload-e2e.mjs",
    "verify:showcase-shape-cycle": "node scripts/verify-showcase-shape-cycle.mjs",
    "verify:showcase-rotate-ease": "node scripts/verify-showcase-rotate-ease.mjs",
    "verify:inner-cube-seams": "node scripts/verify-inner-cube-face-seams.mjs",
    "verify:render-job-crystal": "node scripts/verify-render-job-crystal.mjs",
    "render-worker": "node scripts/render-worker.mjs",
    "generate:showcase-qa-corpus": "node scripts/generate-showcase-qa-corpus.mjs",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace @mbox/api\" \"npm run dev --workspace @mbox/web\"",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:urls": "node scripts/print-dev-urls.mjs",
    "preview": "npm run preview --workspace @mbox/web",
    "preview:container": "docker compose up --build",
    "preview:container:down": "docker compose down",
    "measure:showcase-resources": "node scripts/measure-showcase-resources.mjs",
    "measure:showcase-tiers": "node scripts/compare-showcase-resource-tiers.mjs",
    "export:showcase-mp4": "node scripts/export-showcase-mp4-local.mjs",
    "export:showcase-mp4:qa": "node scripts/export-showcase-mp4-local.mjs --photos data/showcase-qa-corpus/qa_005_portrait.jpg data/showcase-qa-corpus/qa_021_landscape.jpg data/showcase-qa-corpus/qa_012_square.jpg",
    "open:showcase-gpu": "node scripts/open-showcase-gpu.mjs",
    "open:local-gpu": "node scripts/open-showcase-gpu.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0"
  },
  "overrides": {
    "@imgly/background-removal": {
      "onnxruntime-web": "1.21.0"
    }
  }
}
